# Copy to server/.env on the Debian Docker host. Never commit .env.
GITHUB_OWNER=cbwilliams1377-ai
GITHUB_REPO=minimal-kanban
GITHUB_BRANCH=master
# Fine-grained PAT scoped to this repo: Contents R/W and Issues R/W.
GITHUB_TOKEN=replace-me
# Login allowed to answer blocked reports; set explicitly for organization repos.
BUGBOT_OWNER=cbwilliams1377-ai
RUN_TIME=09:00
TZ=America/Chicago
# Enable only after authentication and a successful manual test.
RUN_ON_START=0
SCHEDULE_ENABLED=0
# Poll for new tickets every N minutes instead of a single fixed daily RUN_TIME
# run. Leave empty to keep the daily schedule. Requires SCHEDULE_ENABLED=1.
CHECK_INTERVAL_MIN=
