# Copy to .env in the server/ directory (same dir as docker-compose.yml) and fill in.
# Public repo, so only WRITE operations need tokens; the app+report side needs none.

GITHUB_OWNER=cbwilliams1377-ai
GITHUB_REPO=minimal-kanban

# A fine-grained PAT with: Contents: Read/Write, Issues: Read/Write, Releases: Read/Write.
GITHUB_TOKEN=ghp_xxxxxxxx

# Cron-style daily run time in container local time (HH:MM)
RUN_TIME=09:00

# Run one pass immediately when the container starts (1/0)
RUN_ON_START=1

# Timezone for the scheduled run (e.g. America/New_York)
TZ=America/New_York